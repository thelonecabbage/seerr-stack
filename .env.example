# Copy to .env on the Docker host and adjust for your environment.
# Do not commit .env.

PUID=1000
PGID=1000
TZ=Etc/UTC

# Local deploy/sync settings. Keep real usernames, hostnames, and live paths in
# your untracked .env only.
SEERR_STACK_HOST=user@example-host
SEERR_STACK_REMOTE_COMPOSE=/srv/portainer/stacks/seerr/docker-compose.yml
SEERR_STACK_COMPOSE_DIR=/srv/portainer/stacks/seerr
SEERR_STACK_REMOTE_SCRIPT=/srv/media-stack/scripts/seerr_queue_rescue.py
SEERR_STACK_REMOTE_CRON=/etc/cron.d/seerr-queue-rescue

SEERR_PORT=5055
QBITTORRENT_WEBUI_PORT=8081
QBITTORRENT_TORRENTING_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
SABNZBD_HOST_PORT=8082

SEERR_CONFIG=/srv/seerr/config
MEDIA_CONFIG=/srv/media-stack/config
DOWNLOADS=/srv/media-stack/downloads
MOVIES=/srv/media-stack/media/movies
TV=/srv/media-stack/media/tv

SEERR_RESCUE_CONFIG_DIR=/srv/media-stack/config
SEERR_RESCUE_SCRIPT=/srv/media-stack/scripts/seerr_queue_rescue.py
SEERR_RESCUE_LOG=/var/log/seerr-queue-rescue.log
