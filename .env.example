# Copy to .env on the Docker host and adjust for your environment.
# Do not commit .env.

PUID=1000
PGID=1000
TZ=Etc/UTC

# Local deploy/sync settings. Keep real usernames, hostnames, and live paths in
# your untracked .env only.
SEERR_STACK_HOST=user@example-host
SEERR_STACK_REMOTE_COMPOSE=/srv/portainer/stacks/seerr/docker-compose.yml
SEERR_STACK_COMPOSE_DIR=/srv/portainer/stacks/seerr
SEERR_STACK_REMOTE_SCRIPT=/srv/media-stack/scripts/seerr_queue_rescue.py
SEERR_STACK_REMOTE_CRON=/etc/cron.d/seerr-queue-rescue
SEERR_STACK_REMOTE_PLEX_QBIT_SCRIPT=/srv/media-stack/scripts/plex_qbit_speed_guard.py
SEERR_STACK_REMOTE_PLEX_QBIT_CRON=/etc/cron.d/plex-qbit-speed-guard
SEERR_STACK_REMOTE_PLEX_QBIT_LOGROTATE=/etc/logrotate.d/plex-qbit-speed-guard
SEERR_STACK_REMOTE_OVERSIZED_UNMANIC_SCRIPT=/srv/media-stack/scripts/focus_oversized_radarr_unmanic.py
SEERR_STACK_REMOTE_OVERSIZED_UNMANIC_CRON=/etc/cron.d/focus-oversized-radarr-unmanic

SEERR_PORT=5055
QBITTORRENT_WEBUI_PORT=8081
QBITTORRENT_TORRENTING_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
SABNZBD_HOST_PORT=8082

SEERR_CONFIG=/srv/seerr/config
MEDIA_CONFIG=/srv/media-stack/config
DOWNLOADS=/srv/media-stack/downloads
MOVIES=/srv/media-stack/media/movies
TV=/srv/media-stack/media/tv

SEERR_RESCUE_CONFIG_DIR=/srv/media-stack/config
SEERR_RESCUE_SCRIPT=/srv/media-stack/scripts/seerr_queue_rescue.py
SEERR_RESCUE_LOG=/var/log/seerr-queue-rescue.log

PLEX_QBIT_CONFIG_DIR=/srv/media-stack/config
PLEX_QBIT_PLEX_URL=http://127.0.0.1:32400
PLEX_QBIT_QBIT_URL=http://127.0.0.1:8081
PLEX_QBIT_PLEX_PREFS="/srv/plex/config/Library/Application Support/Plex Media Server/Preferences.xml"
PLEX_QBIT_QBIT_CONF=/srv/media-stack/config/qbittorrent/qBittorrent/qBittorrent.conf
PLEX_QBIT_STATE_FILE=/var/lib/plex-qbit-speed-guard/state.json
PLEX_QBIT_LOCK_FILE=/run/plex-qbit-speed-guard.lock
PLEX_QBIT_IDLE_GRACE_SECONDS=120
PLEX_QBIT_ALT_DL_LIMIT_BYTES=2097152
PLEX_QBIT_ALT_UP_LIMIT_BYTES=-1
PLEX_QBIT_TIMEOUT_SECONDS=10

OVERSIZED_RADARR_CONFIG_DIR=/srv/media-stack/config
OVERSIZED_RADARR_URL=http://127.0.0.1:7878/api/v3
OVERSIZED_RADARR_MOVIES_PREFIX=/movies/
OVERSIZED_UNMANIC_MOVIES_PREFIX=/media/movies/
OVERSIZED_UNMANIC_DB=/srv/unmanic/config/config/unmanic.db
OVERSIZED_RADARR_UNMANIC_STATE=/var/lib/focus-oversized-radarr-unmanic/state.json
OVERSIZED_MOVIE_MIN_BYTES=42949672960
OVERSIZED_MIN_FILE_AGE_SECONDS=1800
OVERSIZED_STABILITY_SECONDS=20
OVERSIZED_UNMANIC_LIBRARY_ID=1
OVERSIZED_UNMANIC_PRIORITY_BOOST=1000000
